let was_alive_x0_y0_z0 = :cells[0, 0, 0]~1
:cells[0, 0, 0] = True if neighbors_x0_y0_z0 == 6 else True if ( was_alive_x0_y0_z0 and ( neighbors_x0_y0_z0 == 5 or neighbors_x0_y0_z0 == 6 or neighbors_x0_y0_z0 == 7 ) ) else False
