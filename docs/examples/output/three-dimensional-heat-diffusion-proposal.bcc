# Compiled BrainCode source expanded from: work_checkout/docs/examples/three-dimensional-heat-diffusion-proposal.bc
# Data-parallel loops are unfolded into indexed assignments.
population :temperature[WIDTH, HEIGHT, DEPTH] of Float32
boundary :temperature = insulated
# instance (:x=0, :y=0, :z=0)
:temperature[0, 0, 0] = :temperature[0, 0, 0]~1 + :alpha * :dt * ( (:temperature[0 - 1, 0, 0]~1 - 2 * :temperature[0, 0, 0]~1 + :temperature[0 + 1, 0, 0]~1) / :dx ** 2 + (:temperature[0, 0 - 1, 0]~1 - 2 * :temperature[0, 0, 0]~1 + :temperature[0, 0 + 1, 0]~1) / :dy ** 2 + (:temperature[0, 0, 0 - 1]~1 - 2 * :temperature[0, 0, 0]~1 + :temperature[0, 0, 0 + 1]~1) / :dz ** 2 )
# instance (:x=0, :y=0, :z=1)
:temperature[0, 0, 1] = :temperature[0, 0, 1]~1 + :alpha * :dt * ( (:temperature[0 - 1, 0, 1]~1 - 2 * :temperature[0, 0, 1]~1 + :temperature[0 + 1, 0, 1]~1) / :dx ** 2 + (:temperature[0, 0 - 1, 1]~1 - 2 * :temperature[0, 0, 1]~1 + :temperature[0, 0 + 1, 1]~1) / :dy ** 2 + (:temperature[0, 0, 1 - 1]~1 - 2 * :temperature[0, 0, 1]~1 + :temperature[0, 0, 1 + 1]~1) / :dz ** 2 )
# instance (:x=0, :y=1, :z=0)
:temperature[0, 1, 0] = :temperature[0, 1, 0]~1 + :alpha * :dt * ( (:temperature[0 - 1, 1, 0]~1 - 2 * :temperature[0, 1, 0]~1 + :temperature[0 + 1, 1, 0]~1) / :dx ** 2 + (:temperature[0, 1 - 1, 0]~1 - 2 * :temperature[0, 1, 0]~1 + :temperature[0, 1 + 1, 0]~1) / :dy ** 2 + (:temperature[0, 1, 0 - 1]~1 - 2 * :temperature[0, 1, 0]~1 + :temperature[0, 1, 0 + 1]~1) / :dz ** 2 )
# instance (:x=0, :y=1, :z=1)
:temperature[0, 1, 1] = :temperature[0, 1, 1]~1 + :alpha * :dt * ( (:temperature[0 - 1, 1, 1]~1 - 2 * :temperature[0, 1, 1]~1 + :temperature[0 + 1, 1, 1]~1) / :dx ** 2 + (:temperature[0, 1 - 1, 1]~1 - 2 * :temperature[0, 1, 1]~1 + :temperature[0, 1 + 1, 1]~1) / :dy ** 2 + (:temperature[0, 1, 1 - 1]~1 - 2 * :temperature[0, 1, 1]~1 + :temperature[0, 1, 1 + 1]~1) / :dz ** 2 )
# instance (:x=1, :y=0, :z=0)
:temperature[1, 0, 0] = :temperature[1, 0, 0]~1 + :alpha * :dt * ( (:temperature[1 - 1, 0, 0]~1 - 2 * :temperature[1, 0, 0]~1 + :temperature[1 + 1, 0, 0]~1) / :dx ** 2 + (:temperature[1, 0 - 1, 0]~1 - 2 * :temperature[1, 0, 0]~1 + :temperature[1, 0 + 1, 0]~1) / :dy ** 2 + (:temperature[1, 0, 0 - 1]~1 - 2 * :temperature[1, 0, 0]~1 + :temperature[1, 0, 0 + 1]~1) / :dz ** 2 )
# instance (:x=1, :y=0, :z=1)
:temperature[1, 0, 1] = :temperature[1, 0, 1]~1 + :alpha * :dt * ( (:temperature[1 - 1, 0, 1]~1 - 2 * :temperature[1, 0, 1]~1 + :temperature[1 + 1, 0, 1]~1) / :dx ** 2 + (:temperature[1, 0 - 1, 1]~1 - 2 * :temperature[1, 0, 1]~1 + :temperature[1, 0 + 1, 1]~1) / :dy ** 2 + (:temperature[1, 0, 1 - 1]~1 - 2 * :temperature[1, 0, 1]~1 + :temperature[1, 0, 1 + 1]~1) / :dz ** 2 )
# instance (:x=1, :y=1, :z=0)
:temperature[1, 1, 0] = :temperature[1, 1, 0]~1 + :alpha * :dt * ( (:temperature[1 - 1, 1, 0]~1 - 2 * :temperature[1, 1, 0]~1 + :temperature[1 + 1, 1, 0]~1) / :dx ** 2 + (:temperature[1, 1 - 1, 0]~1 - 2 * :temperature[1, 1, 0]~1 + :temperature[1, 1 + 1, 0]~1) / :dy ** 2 + (:temperature[1, 1, 0 - 1]~1 - 2 * :temperature[1, 1, 0]~1 + :temperature[1, 1, 0 + 1]~1) / :dz ** 2 )
# instance (:x=1, :y=1, :z=1)
:temperature[1, 1, 1] = :temperature[1, 1, 1]~1 + :alpha * :dt * ( (:temperature[1 - 1, 1, 1]~1 - 2 * :temperature[1, 1, 1]~1 + :temperature[1 + 1, 1, 1]~1) / :dx ** 2 + (:temperature[1, 1 - 1, 1]~1 - 2 * :temperature[1, 1, 1]~1 + :temperature[1, 1 + 1, 1]~1) / :dy ** 2 + (:temperature[1, 1, 1 - 1]~1 - 2 * :temperature[1, 1, 1]~1 + :temperature[1, 1, 1 + 1]~1) / :dz ** 2 )
