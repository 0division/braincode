# Compiled BrainCode source expanded from: C:\GDrive\Proj\2026_braincode\docs\examples\nbody-all-pairs-proposal.bc
# Data-parallel loops are unfolded into indexed assignments.
population :bodies[BODY_COUNT] of Float64
population :mass[BODY_COUNT] of Float64
population :position[BODY_COUNT, VECTOR_DIM] of Float64
population :velocity[BODY_COUNT, VECTOR_DIM] of Float64
# instance (:i=0)
let acceleration_i0 = sum( :G * :mass[:j] * (:position[:j]~1 - :position[0]~1) / ( length(:position[:j]~1 - :position[0]~1) ** 2 + :softening ** 2 ) ** 1.5 for :j in range(:BODY_COUNT) if :j != 0 )
:velocity[0] = :velocity[0]~1 + :time_step * acceleration_i0
:position[0] = :position[0]~1 + :time_step * :velocity[0]~1
# instance (:i=1)
let acceleration_i1 = sum( :G * :mass[:j] * (:position[:j]~1 - :position[1]~1) / ( length(:position[:j]~1 - :position[1]~1) ** 2 + :softening ** 2 ) ** 1.5 for :j in range(:BODY_COUNT) if :j != 1 )
:velocity[1] = :velocity[1]~1 + :time_step * acceleration_i1
:position[1] = :position[1]~1 + :time_step * :velocity[1]~1
